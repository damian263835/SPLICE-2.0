class ORIONOrchestrator:
    def __init__(self, start_sec: float, duration: float):
        self.start_sec = start_sec
        self.duration = duration
        self.local_file = "forensic_output/_target.mp4"
        self.events: List[ForensicEvent] = []
        
        print("=========================================================")
        print("ACTION REQUIRED: Upload your video file below.")
        print("=========================================================")
        uploaded = files.upload()
        
        if not uploaded:
            raise Exception("Upload cancelled or failed. Please run the cell again.")
            
        source_video = list(uploaded.keys())[0]
        logging.info(f"Target locked: {source_video}. Slicing the exact {self.duration}s window via FFmpeg...")
        
        if os.path.exists(self.local_file): 
            os.remove(self.local_file)
        
        subprocess.run(["ffmpeg", "-y", "-ss", str(self.start_sec), "-i", source_video, 
                        "-t", str(self.duration), "-c", "copy", self.local_file], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
                       
        if not os.path.exists(self.local_file):
            raise Exception("FFmpeg extraction failed. Make sure the file format is valid.")
            
        print("[+] 20-second segment successfully isolated. Initializing forensic scan...")

    def run_algorithmic_scan(self):
        logging.info("Initializing Asynchronous Multi-Threaded  Scan...")
        
        entity_tracker = KineticEntityTracker()
        ssim_scanner = SSIMIntegrityScanner()
        furnace_analyzer = FurnaceAnalyzer()
        
        cap = cv2.VideoCapture(self.local_file)
        fps = cap.get(cv2.CAP_PROP_FPS)
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        
        frame_idx = 0
        ssim_history = []
        
        # 4. Asynchronous Multi-Threading Execution
        with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
            while cap.isOpened():
                ret, frame = cap.read()
                if not ret: break
                    
                current_time = frame_idx / fps
                
                # Dispatch modules to separate threads concurrently
                future_ssim = executor.submit(ssim_scanner.check_integrity, frame.copy(), current_time, frame_idx)
                future_furnace = executor.submit(furnace_analyzer.analyze_frame, frame.copy(), current_time, frame_idx)
                future_kinetic = executor.submit(entity_tracker.process_frame, frame.copy(), current_time, frame_idx)
                
                # Retrieve threaded results
                ssim_score, ssim_event = future_ssim.result()
                furnace_event = future_furnace.result()
                kinetic_events = future_kinetic.result()
                
                ssim_history.append((current_time, ssim_score))
                
                if ssim_event: self.events.append(ssim_event); logging.warning(ssim_event.mathematical_proof)
            #  if furnace_event: self.events.append(furnace_event); logging.warning(furnace_event.mathematical_proof)
                for e in kinetic_events: self.events.append(e); logging.warning(e.mathematical_proof)

                frame_idx += 1
                if frame_idx % (int(fps) * 2) == 0:
                    logging.info(f"Threaded Processing: {current_time:.1f}s / {total_frames/fps:.1f}s")
                    
        cap.release()
        self.generate_reports(ssim_history)

    def generate_reports(self, ssim_history):
        logging.info("Exporting JSON and CSV Ledgers...")
        with open("forensic_output/_report.json", 'w') as f:
            json.dump([asdict(e) for e in self.events], f, indent=4)
            
        with open("forensic_output/_ledger.csv", 'w', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(["Timestamp (s)", "Frame", "Category", "Metric", "Confidence", "Proof"])
            for e in self.events:
                writer.writerow([e.timestamp_sec, e.frame_index, e.anomaly_category, e.deviation_metric, e.confidence_interval, e.mathematical_proof])
        logging.info(" Analysis Complete.")

